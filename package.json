{
  "name": "citadels-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/room-host.test.mjs",
    "start": "vite --host 0.0.0.0",
    "legacy:online": "tsc -p tsconfig.server.json && node server/index.mjs",
    "package:offline": "npm run build && python scripts/package-offline.py",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  }
}
