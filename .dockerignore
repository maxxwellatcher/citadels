# Only the source files required by this Dockerfile enter the build context.
*
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!index.html
!tsconfig.json
!tsconfig.server.json
!vite.config.ts
!src/
!src/**
!public/
!public/**
!server/
!server/index.mjs

# Exclude local outputs, dependencies, logs, and account files at any depth.
**/node_modules
**/output
**/outputs
**/docs
**/dist
**/server-build
**/.git
**/.env*
**/.npmrc
**/.pnpmrc
**/.cloudbase*
**/cloudbaserc*
**/*credential*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.zip
**/.playwright-cli
**/.codex
